  <!-- 仅正式生产目标更新共享对象库，临时检查程序不得覆盖测试依赖。 -->
  <Target Name="ExportYQYRuntime" AfterTargets="Link"
          Condition="'$(DesignTimeBuild)' != 'true' and ('$(TargetName)' == 'YQY' or '$(TargetName)' == 'YQYVerification')">
    <ItemGroup>
      <YQYRuntimeEntryObject Include="@(Link)"
                             Condition="'%(Link.Extension)' == '.obj' and '%(Link.Filename)' == 'main'" />
      <YQYRuntimeCoreObject Include="@(Link)"
                            Condition="'%(Link.Extension)' == '.obj' and '%(Link.Filename)' == 'Outputter'" />
      <YQYRuntimeObject Include="@(Link)"
                        Condition="'%(Link.Extension)' == '.obj' and '%(Link.Filename)' != 'main'" />
    </ItemGroup>
    <Error Condition="'@(YQYRuntimeEntryObject)' == '' or '@(YQYRuntimeCoreObject)' == ''"
           Text="正式生产链接缺少 main.obj 或 Outputter.obj，拒绝覆盖测试共享库。" />
    <Error Condition="'@(YQYRuntimeObject)' == ''" Text="未找到本次构建的生产代码对象，无法生成测试依赖库。" />
    <MakeDir Directories="$(IntDir)RuntimeLibrary\" />
    <LIB Sources="@(YQYRuntimeObject)" OutputFile="$(OutDir)YQYRuntime.lib" TargetMachine="MachineX64"
         SuppressStartupBanner="true" ToolPath="$(LIBToolPath)" ToolExe="$(LIBToolExe)"
         ToolArchitecture="$(VCToolArchitecture)" MinimalRebuildFromTracking="true"
         TrackFileAccess="$(TrackFileAccess)" TrackerLogDirectory="$(IntDir)RuntimeLibrary\"
         TLogReadFiles="$(IntDir)RuntimeLibrary\runtime.read.1.tlog"
         TLogWriteFiles="$(IntDir)RuntimeLibrary\runtime.write.1.tlog" />
    <ItemGroup>
      <FileWrites Include="$(OutDir)YQYRuntime.lib" />
    </ItemGroup>
  </Target>
