<ui version="4.0">
 <class>SolveTaskManagerDialogClass</class>
 <widget class="QDialog" name="SolveTaskManagerDialogClass">
  <property name="windowTitle"><string>全部分析步求解</string></property>
  <property name="minimumSize"><size><width>720</width><height>380</height></size></property>
  <layout class="QVBoxLayout" name="rootLayout">
   <property name="leftMargin"><number>16</number></property><property name="topMargin"><number>16</number></property><property name="rightMargin"><number>16</number></property><property name="bottomMargin"><number>12</number></property><property name="spacing"><number>12</number></property>
   <item><layout class="QHBoxLayout" name="summaryLayout">
