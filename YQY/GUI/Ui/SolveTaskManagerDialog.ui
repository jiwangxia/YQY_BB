   <item><widget class="QTableWidget" name="taskTable"><property name="columnCount"><number>6</number></property><property name="selectionBehavior"><enum>QAbstractItemView::SelectRows</enum></property><property name="selectionMode"><enum>QAbstractItemView::SingleSelection</enum></property><property name="editTriggers"><set>QAbstractItemView::NoEditTriggers</set></property><property name="alternatingRowColors"><bool>true</bool></property><column><property name="text"><string>操作</string></property></column><column><property name="text"><string>算例名称</string></property></column><column><property name="text"><string>分析步</string></property></column><column><property name="text"><string>进度</string></property></column><column><property name="text"><string>结果</string></property></column><column><property name="text"><string>耗时</string></property></column></widget></item>
