    <item><spacer name="summarySpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint"><size><width>40</width><height>20</height></size></property></spacer></item>
    <item><widget class="QPushButton" name="solveAllButton"><property name="text"><string>全部计算</string></property><property name="minimumSize"><size><width>132</width><height>0</height></size></property><property name="toolTip"><string>将所有待运行分析步加入队列；正在计算、已排队和已有结果的算例不会重复计算；单个分析步失败不会停止其他队列任务</string></property></widget></item>
